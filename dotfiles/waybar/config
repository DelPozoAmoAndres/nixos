{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar at the bottom of your screen
    "height": 24, // Waybar height
    "output": "DP-1",
    // "width": 1366, // Waybar width

    // Choose the order of the modules
    "modules-left": ["tray","custom/ytmusic"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["pulseaudio", "cpu", "memory", "custom/wifi","custom/bluetooth", "clock"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "1:web": "",
            "2:code": "",
            "3:term": "",
            "4:work": "",
            "5:music": "",
            "6:docs": "",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "  {usage}%"
    },
    "memory": {
        "format": "  {}%"
    },
    "pulseaudio": {
        "format": "{icon}   {volume}% ",
        "format-bluetooth": "{icon}   {volume}% ",
        "format-muted": "",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/ytmusic": {
        "format": " {}",
        "max-length": 40,
        "interval": 1, 
        "exec": "$HOME/.config/waybar/mediaplayer.sh 2> /dev/null" 
    },
    "custom/wifi": {
        "format": "  ",
        "tooltip": true,
        "tooltip-format": "{}",
        "exec": "$HOME/.config/waybar/wifistatus.sh",
        "interval": 1,
        "on-click": "$HOME/.config/waybar/wifimenu.sh"
    },
    "custom/bluetooth": {
        "format": " ",
        "tooltip": true,
        "tooltip-format": "{}",
        "exec": "$HOME/.config/waybar/bluetoothstatus.sh",
        "interval": 1,
        "on-click": "$HOME/.config/waybar/bluetoothmenu.sh"
    }
}
