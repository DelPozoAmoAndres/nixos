{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar at the bottom of your screen
    "height": 24, // Waybar height
    "output": "DP-1",
    // "width": 1366, // Waybar width

    // Choose the order of the modules
    "modules-left": ["tray","custom/ytmusic"],
    "modules-center": ["hyprland/window"],
    // "cpu#0".."cpu#7" son los 8 hilos logicos del i7-4790 (4 nucleos
    // fisicos x 2 SMT). Cada uno muestra su propio porcentaje.
    "modules-right": ["pulseaudio", "cpu", "cpu#0", "cpu#1", "cpu#2", "cpu#3", "cpu#4", "cpu#5", "cpu#6", "cpu#7", "memory", "custom/wifi","custom/bluetooth", "clock"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "1:web": "",
            "2:code": "",
            "3:term": "",
            "4:work": "",
            "5:music": "",
            "6:docs": "",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "  {usage}%"
    },
    // ── CPU por nucleo ──────────────────────────────────────────────────
    // El i7-4790 tiene 4 nucleos fisicos con SMT (2 hilos por nucleo):
    // los hilos 0-7 son los logicos. Waybar lee /proc/stat con recorrido
    // lineal, asi que cpu#0 y cpu#1 son los dos hilos del nucleo 0,
    // cpu#2 y cpu#3 los del nucleo 1, y asi sucesivamente.
    "cpu#0": { "format": "{usage}%", "tooltip": true },
    "cpu#1": { "format": "{usage}%", "tooltip": true },
    "cpu#2": { "format": "{usage}%", "tooltip": true },
    "cpu#3": { "format": "{usage}%", "tooltip": true },
    "cpu#4": { "format": "{usage}%", "tooltip": true },
    "cpu#5": { "format": "{usage}%", "tooltip": true },
    "cpu#6": { "format": "{usage}%", "tooltip": true },
    "cpu#7": { "format": "{usage}%", "tooltip": true },
    "memory": {
        "format": "  {}%"
    },
    "pulseaudio": {
        "format": "{icon}   {volume}% ",
        "format-bluetooth": "{icon}   {volume}% ",
        "format-muted": "",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/ytmusic": {
        "format": " {}",
        "max-length": 40,
        "interval": 1, 
        "exec": "$HOME/.config/waybar/mediaplayer.sh 2> /dev/null" 
    },
    "custom/wifi": {
        "format": "  ",
        "tooltip": true,
        "tooltip-format": "{}",
        "exec": "$HOME/.config/waybar/wifistatus.sh",
        "interval": 1,
        "on-click": "$HOME/.config/waybar/wifimenu.sh"
    },
    "custom/bluetooth": {
        "format": " ",
        "tooltip": true,
        "tooltip-format": "{}",
        "exec": "$HOME/.config/waybar/bluetoothstatus.sh",
        "interval": 1,
        "on-click": "$HOME/.config/waybar/bluetoothmenu.sh"
    }
}
