{
  "$schema": "https://opencode.ai/config.json",

  // ── Default Model ────────────────────────────────────────────
  "model": "opencode-go/mimo-v2.6-flash",

  // ── MCP Servers ──────────────────────────────────────────────
  // Las claves de Stitch y Penpot no están aquí: son marcadores que
  // sops sustituye por los valores descifrados al desplegar este fichero
  // (ver home.nix, sops.templates). El repo nunca guarda las claves.
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "__STITCH_API_KEY__"
      }
    },
    "penpot": {
      "type": "remote",
      "url": "https://design.penpot.app/mcp/stream?userToken=__PENPOT_MCP_KEY__",
      "enabled": true
    }
  },

  // ── Agent Configurations ─────────────────────────────────────
  "agent": {
    "build": {
      "description": "Primary agent with all tools enabled for development work",
      "mode": "primary",
      "temperature": 0.3
    },
    "plan": {
      "description": "Planning and analysis without making changes",
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    }
  },

  // ── Skill Permissions ────────────────────────────────────────
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "plugin": [
    [
      "opencode-orchestrator",
      {
        "agentConcurrency": {
          "commander": 1,
          "planner": 10,
          "worker": 10,
          "reviewer": 10
        },
        "missionLoop": {
          "ledger": true,
          "markdownMemory": true
        }
      }
    ]
  ]
}
